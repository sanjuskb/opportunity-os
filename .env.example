# ==============================================================================
# OPPORTUNITY OS - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# NOTE: This file contains only variable keys and safe placeholders.
# DO NOT commit real secrets, API keys, or database credentials to git.
# Copy this file to .env or .env.local for local development.

# --- Environment & Runtime ---
ENVIRONMENT=development
LOG_LEVEL=info
DEBUG=true

# --- Application Routing & Ports ---
FRONTEND_PORT=3000
BACKEND_PORT=8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Supabase & PostgreSQL (with pgvector) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=placeholder-supabase-service-role-key-here
SUPABASE_JWT_SECRET=placeholder-supabase-jwt-secret-at-least-32-chars-long
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@localhost:54322/postgres

# --- Redis (Cache & Task Queue) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=placeholder-optional-redis-password
REDIS_URL=redis://localhost:6379/0

# --- Google Gemini AI & Live API ---
GEMINI_API_KEY=placeholder-google-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_LIVE_WEBSOCKET_URL=wss://generativelanguage.googleapis.com/ws/google.ai.generativelanguage.v1alpha.GenerativeService.BidiGenerateContent

# --- Olostep API (Live Web Scraping, Search, Crawl & Monitoring) ---
OLOSTEP_API_KEY=placeholder-olostep-api-key
OLOSTEP_API_BASE_URL=https://api.olostep.com

# --- Crustdata API (Company, Firmographics & Professional Intelligence) ---
CRUSTDATA_API_KEY=placeholder-crustdata-api-key
CRUSTDATA_API_BASE_URL=https://api.crustdata.com
CRUSTDATA_API_VERSION=2025-11-01

# --- Browser Automation (Playwright Sandbox) ---
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=30000
PLAYWRIGHT_SCREENSHOT_DIR=./test-results/screenshots
PLAYWRIGHT_STORAGE_STATE_DIR=./test-results/storage

# --- Background Task Worker (ARQ) ---
ARQ_MAX_CONCURRENT_TASKS=10
ARQ_TASK_TIMEOUT_SECONDS=300

# --- Monitoring & Observability ---
SENTRY_DSN=placeholder-optional-sentry-dsn
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
ENABLE_TELEMETRY=false
