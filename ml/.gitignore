# ML Subsystem .gitignore

# Python Bytecode & Environments
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/
.pytest_cache/
.ruff_cache/

# Large Datasets & Raw Data
datasets/raw/*
datasets/processed/*
datasets/processed_v2/*
!datasets/README.md
!datasets/synthetic/
datasets/synthetic/*.csv
datasets/synthetic/*.parquet
datasets/synthetic/*.large.*
*.csv
*.parquet
*.zip
*.tar.gz

# Model Caches, Checkpoints & Weights
.cache/
hf_cache/
huggingface/
models_cache/
*.pt
*.pth
*.bin
*.safetensors
*.onnx
*.onnx.data
*.h5
*.ckpt
checkpoints/
models_exported/
artifacts/

# Experiment Logs & Tracking
mlruns/
.dvc/cache/
wandb/
*.log
experiments/runs/*
!experiments/runs/.gitkeep

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/

# OS and Secrets
.env
.env.local
*.pem
*.key
